{
  // Non-AI editor
  "cli_default_open_behavior": "new_window",
  "disable_ai": true,

  // Privacy: disable usage metrics and crash reporting
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },

  // Appearance
  "theme": "Lydia Darker",
  "icon_theme": "Flow Deep",
  "ui_font_size": 15.0,
  "ui_font_family": "JetBrains Mono",
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 16.0,

  // Editor behavior
  "helix_mode": true,
  "which_key": {
    "enabled": true,
    "delay_ms": 0,
  },
  "double_click_in_multibuffer": "open",
  "soft_wrap": "bounded",
  "show_wrap_guides": false,
  "scroll_beyond_last_line": "off",
  "hover_popover_delay": 700,
  "seed_search_query_from_cursor": "selection",
  "drag_and_drop_selection": {
    "enabled": false,
  },
  "preview_tabs": {
    "enabled": false,
  },

  // Editor chrome
  "gutter": {
    "bookmarks": false,
    "breakpoints": false,
    "runnables": false,
    "folds": false,
    "min_line_number_digits": 3,
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false,
  },
  "toolbar": {
    "breadcrumbs": false,
    "selections_menu": false,
    "quick_actions": false,
  },

  // Project tree and panels (hidden buttons do not disable the panels)
  "project_panel": {
    "dock": "left",
    "button": false,
    "entry_spacing": "comfortable",
    "hide_root": true,
    "indent_size": 12,
    "drag_and_drop": false,
    "sticky_scroll": false,
    "indent_guides": {
      "show": "never",
    },
  },
  "outline_panel": {
    "dock": "left",
    "button": false,
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "git_panel": {
    "tree_view": false,
    "button": false,
  },
  "terminal": {
    "button": false,
    "font_size": 15,
  },
  "debugger": {
    "button": false,
  },

  // Status bar
  "diagnostics": {
    "button": false,
  },
  "search": {
    "button": false,
  },
  "global_lsp_settings": {
    "button": false,
  },

  // Git
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },

  // Language tooling: ESLint fixes first, then Prettier formatting on save
  "languages": {
    "JavaScript": {
      "format_on_save": "on",
      "formatter": [
        { "code_action": "source.fixAll.eslint" },
        "prettier",
      ],
    },
    "TypeScript": {
      "format_on_save": "on",
      "formatter": [
        { "code_action": "source.fixAll.eslint" },
        "prettier",
      ],
    },
    "TSX": {
      "format_on_save": "on",
      "formatter": [
        { "code_action": "source.fixAll.eslint" },
        "prettier",
      ],
    },
  },
}
